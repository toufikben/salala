  "detailStoryLine": "Every entry here is part of her story.",
  "@detailStoryLine": {
    "description": "One quiet line under the animal's facts on her own page. Said once, never on every card: a herd of forty dogs does not want forty mottoes. Deliberately not an instruction and not an exclamation."
  },
  "detailDiedLine": "Her record stays as it was.",
  "@detailDiedLine": {
    "description": "Shown in place of the story line on an animal whose death date is recorded. Quiet, not consoling: the app is not the person to grieve with, and a longer sentence here reads as sympathy the app has not earned."
  },
  "placedFarewell": "{name} has gone to a new home. The record stays with you.",
  "@placedFarewell": {
    "description": "Shown once, after a handover is saved. Respects the move rather than celebrating a sale — a placed breeding dog is a loss to the kennel as much as a transaction.",
    "placeholders": {
      "name": {
        "type": "String"
      }
    }
  },
  "reminderHeadsUpBody": "Heads up: {what} is due on {dueDay}",
  "@reminderHeadsUpBody": {
    "description": "The month-ahead alarm. {what} is the dose or screening name as the breeder typed it, {dueDay} a localised date. The tone is a nudge between equals: no 'Don't forget', no exclamation mark, and the word 'heads up' rather than 'reminder' because a reminder implies the breeder would have forgotten.",
    "placeholders": {
      "what": {
        "type": "String"
      },
      "dueDay": {
        "type": "String"
      }
    }
  },
  "reminderDueBody": "{what} is due today. Two minutes is enough",
  "@reminderDueBody": {
    "description": "The morning-of alarm. The second half is the whole point of the sentence: it says the task is small, because a breeder who reads a bare due-date at six in the morning reads it as another thing she is behind on.",
    "placeholders": {
      "what": {
        "type": "String"
      }
    }
  },

  "aboutTitle": "About Companion",
  "aboutBody": "An offline ledger for a small kennel or cattery. No account, no server, no tracking — the records live on this phone and leave it only through your own hands.",
  "aboutVersion": "Version {version}",
  "@aboutVersion": {

<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon: the launcher supplies the mask, so the mark is drawn in the
     middle 72dp of the 108dp canvas and nothing important sits outside the
     66dp safe circle. Pre-8.0 devices fall back to the mipmap PNGs. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>

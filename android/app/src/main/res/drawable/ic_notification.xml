<?xml version="1.0" encoding="utf-8"?>
<!--
  The notification's small icon.

  Android draws this as a flat silhouette and discards every colour, so it is
  white-on-transparent by contract rather than by taste: the launcher icon
  (`@mipmap/ic_launcher`) is a full-colour square, and handing it to the status
  bar produced a white block. A paw print is legible at 24dp, which is the only
  size it is ever drawn at, and it says "an animal" before the title is read.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFFFF">
    <!-- The pad of the paw. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,13.2c-2.1,0 -4.6,1.9 -4.6,4.1c0,1.5 1.1,2.4 2.6,2.4c0.8,0 1.4,-0.3 2,-0.3c0.6,0 1.2,0.3 2,0.3c1.5,0 2.6,-0.9 2.6,-2.4C16.6,15.1 14.1,13.2 12,13.2z" />
    <!-- Four toes. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M7.1,11.4c1,0 1.8,-1.1 1.8,-2.5S8.1,6.4 7.1,6.4S5.3,7.5 5.3,8.9S6.1,11.4 7.1,11.4z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M10.1,8.2c1,0 1.8,-1.2 1.8,-2.6S11.1,3 10.1,3S8.3,4.2 8.3,5.6S9.1,8.2 10.1,8.2z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M13.9,8.2c1,0 1.8,-1.2 1.8,-2.6S14.9,3 13.9,3s-1.8,1.2 -1.8,2.6S12.9,8.2 13.9,8.2z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M16.9,11.4c1,0 1.8,-1.1 1.8,-2.5s-0.8,-2.5 -1.8,-2.5s-1.8,1.1 -1.8,2.5S15.9,11.4 16.9,11.4z" />
</vector>
